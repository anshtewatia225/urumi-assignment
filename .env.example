# Example for running the gateway outside Kubernetes (local development only).
# Never commit real values. In the cluster these come from Kubernetes Secrets.

PORT=8080
DATABASE_URL=postgres://urumi:change-me@localhost:5432/urumi_gateway

# 32 random bytes, base64 encoded (openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=
# Long random string
SESSION_SECRET=
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

ADMIN_EMAIL=admin@urumi.local
ADMIN_NAME=Urumi Admin
ADMIN_PASSWORD=change-me

# OpenAI-compatible provider
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# The install scripts read this (OPENROUTER_API_KEY is accepted as an alias).
LLM_API_KEY=

ALLOW_PRIVATE_UPSTREAMS=true
TOOL_LIST_TIMEOUT_MS=5000
TOOL_CALL_TIMEOUT_MS=30000
TOOL_CACHE_TTL_MS=15000

# Optional comma-separated list of allowed browser origins for credentialed requests.
CORS_ORIGIN=

# Optional JSON array of upstream servers to seed on first boot.
SEED_UPSTREAMS=[]
