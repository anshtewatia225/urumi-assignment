# Normalize line endings: LF in the repository, sensible per-platform checkouts.
* text=auto

# Shell scripts must stay LF or they fail to run on Linux/macOS and on the k3s VPS.
*.sh text eol=lf

# PowerShell scripts are CRLF-friendly.
*.ps1 text eol=crlf

# Keep config and source text as LF.
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
